# LLM Configuration
# Choose ONE option below:

# Option 1: OpenAI (GPT-4) - REQUIRES PAYMENT
# OPENAI_API_KEY=sk-proj-your-key-here

# Option 2: Anthropic (Claude) - REQUIRES PAYMENT
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 3: Hugging Face (Online) - FREE with limits (requires model access)
# Get token from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_TOKEN=your_token_here
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Option 4: Ollama (Local LLM) - 100% FREE, NO PAYMENT (requires download)
# Install Ollama first: https://ollama.com/download
# Then run: ollama pull llama3.1
USE_OLLAMA=false
OLLAMA_MODEL=llama3.1

# Agent Configuration
CONFIDENCE_THRESHOLD=0.80
MAX_LINES_PER_PR=50
ENABLE_AUTO_PR=false

# GitHub Configuration (Optional - for creating real PRs)
# GITHUB_TOKEN=your-github-token
# GITHUB_REPO=your-org/your-repo
